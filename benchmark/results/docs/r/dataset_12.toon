header:
  d: "20260603"
  l: en
  t: Argumentative essay
  k: 4
  scale: 0-3
criteria[12]:
  - id: r1
    dimension: Argument
    criterion: Thesis clarity
    levels[4]: absent or unclear,stated but vague,clear and focused,"clear, focused and original"
    weight: 0.2
    evidence: Introduction paragraph
  - id: r2
    dimension: Argument
    criterion: Use of evidence
    levels[4]: no evidence,evidence unrelated to claims,relevant evidence,"relevant, well-integrated evidence"
    weight: 0.2
    evidence: Body paragraphs
  - id: r3
    dimension: Argument
    criterion: Counterarguments
    levels[4]: ignored,mentioned,addressed,addressed and refuted
    weight: 0.1
    evidence: Discussion section
  - id: r4
    dimension: Structure
    criterion: Organization
    levels[4]: disorganized,partially organized,logical order,logical order with transitions
    weight: 0.1
    evidence: Whole essay
  - id: r5
    dimension: Structure
    criterion: Paragraphing
    levels[4]: no paragraphs,inconsistent,one idea per paragraph,purposeful paragraphing
    weight: 0.05
    evidence: Whole essay
  - id: r6
    dimension: Language
    criterion: Grammar and mechanics
    levels[4]: frequent errors,several errors,few errors,error-free
    weight: 0.1
    evidence: Whole essay
  - id: r7
    dimension: Language
    criterion: Academic register
    levels[4]: informal,mixed,mostly academic,consistently academic
    weight: 0.05
    evidence: Whole essay
  - id: r8
    dimension: Sources
    criterion: Citation accuracy
    levels[4]: missing,inconsistent,mostly correct,correct APA/IEEE
    weight: 0.1
    evidence: Reference list
  - id: r9
    dimension: Sources
    criterion: Source quality
    levels[4]: unreliable,mixed,reliable,peer-reviewed and recent
    weight: 0.05
    evidence: Reference list
  - id: r10
    dimension: Critical thinking
    criterion: Analysis depth
    levels[4]: descriptive only,some analysis,consistent analysis,insightful analysis
    weight: 0.03
    evidence: Body paragraphs
  - id: r11
    dimension: Critical thinking
    criterion: Synthesis
    levels[4]: none,lists ideas,connects ideas,builds new insight
    weight: 0.01
    evidence: Conclusion
  - id: r12
    dimension: Presentation
    criterion: Formatting
    levels[4]: not followed,partially,mostly,fully compliant
    weight: 0.01
    evidence: Document
