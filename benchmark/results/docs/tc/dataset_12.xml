<tc d="20260603" l="en" t="SIMA release 1.2 regression" proj="SIMA">
  <rec>
    <id>TC-001</id>
    <module>auth</module>
    <title>Login with valid credentials</title>
    <precondition>User registered and active</precondition>
    <steps><i>open /login</i><i>enter valid email and password</i><i>click Sign in</i></steps>
    <expected>Dashboard is shown and session cookie is set</expected>
