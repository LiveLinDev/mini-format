    {
      "id": "opt-list-empty-null",
      "category": "optionals",
      "description": "lista opcional vacía es null; lista requerida vacía es []",
      "mode": "strict",
      "contract": {
        "prefix": "ol",
        "records_key": "rows",
        "core": [
          {
            "name": "id",
            "type": "str"
          },
          {
            "name": "req",
            "type": "list",
            "item": "str"
          },
          {
            "name": "opt",
            "type": "list",
            "item": "int",
            "optional": true,
            "min": 1
          }
        ],
        "extensions": [
          {
            "name": "sel",
            "type": "mlist",
            "item": "str",
            "marker": "exactly_one",
            "json": {
              "items": "sel",
              "selected": "sel_i"
            }
          },
          {
            "name": "tags",
            "type": "list",
            "item": "str"
          }
        ]
      },
      "input": "ol|n=1\nr1|||a*,b",
      "expected": {
        "canonical": {
          "prefix": "ol",
          "header": {
            "v": 1,
            "n": 1
          },
          "rows": [
            {
              "id": "r1",
              "req": [],
              "opt": null,
              "sel": [
                "a",
                "b"
              ],
              "sel_i": 0,
              "tags": null
            }
          ]
        },
        "mini": "ol|n=1\nr1|||a*,b"
      }
    },
