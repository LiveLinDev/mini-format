{
  "suite": ".mini conformance",
  "spec": "1.1",
  "category": "optionals",
  "cases": [
    {
      "id": "opt-ext-omitted",
      "category": "optionals",
      "description": "extensiones omitidas valen null",
      "mode": "strict",
      "contract": {
        "prefix": "sc",
        "records_key": "rows",
        "core": [
          {
            "name": "id",
            "type": "str",
            "unique": true
          },
          {
            "name": "qty",
            "type": "int",
            "min": 0,
            "max": 100
          },
          {
            "name": "ratio",
            "type": "float",
            "min": -1,
            "max": 1
          },
          {
            "name": "flag",
            "type": "bool"
          },
          {
            "name": "color",
            "type": "enum",
            "values": [
              "red",
              "green",
              "blue"
            ]
          }
        ],
        "extensions": [
          {
            "name": "memo",
            "type": "str"
          },
          {
            "name": "extra",
            "type": "int"
          }
        ]
      },
      "input": "sc|n=1\nr1|5|0.5|true|red",
      "expected": {
        "canonical": {
          "prefix": "sc",
          "header": {
            "v": 1,
            "n": 1
          },
          "rows": [
            {
              "id": "r1",
              "qty": 5,
              "ratio": 0.5,
              "flag": true,
              "color": "red",
              "memo": null,
              "extra": null
            }
          ]
        }
      }
    },
