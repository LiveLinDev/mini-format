{
  "suite": ".mini conformance",
  "spec": "1.1",
  "category": "truncation",
  "cases": [
    {
      "id": "trunc-last-record-cut",
      "category": "truncation",
      "description": "último registro incompleto: se reporta su línea y se conservan los anteriores",
      "mode": "lenient",
      "contract": {
        "prefix": "sc",
        "records_key": "rows",
        "core": [
          {
            "name": "id",
            "type": "str",
            "unique": true
          },
          {
            "name": "qty",
            "type": "int",
            "min": 0,
            "max": 100
          },
          {
            "name": "ratio",
            "type": "float",
            "min": -1,
            "max": 1
          },
          {
            "name": "flag",
            "type": "bool"
          },
          {
            "name": "color",
            "type": "enum",
            "values": [
              "red",
              "green",
              "blue"
            ]
          }
        ],
        "extensions": [
          {
            "name": "memo",
            "type": "str"
          },
          {
            "name": "extra",
            "type": "int"
          }
        ]
      },
      "input": "sc|n=3\nr1|5|0.5|true|red\nr2|6|0.5|true|green\nr3|7|0.5",
      "expected": {
        "canonical": {
          "prefix": "sc",
          "header": {
            "v": 1,
            "n": 3
          },
          "rows": [
            {
              "id": "r1",
              "qty": 5,
              "ratio": 0.5,
              "flag": true,
              "color": "red",
              "memo": null,
              "extra": null
            },
            {
              "id": "r2",
              "qty": 6,
              "ratio": 0.5,
              "flag": true,
              "color": "green",
              "memo": null,
              "extra": null
            }
          ]
        },
        "errors": [
          {
            "code": "E05",
            "line": 4
          }
        ],
        "diagnostics": {
          "invalid_lines": [
            4
          ],
          "missing_records": 0
        }
      }
    },
