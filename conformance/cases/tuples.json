{
  "suite": ".mini conformance",
  "spec": "1.0",
  "category": "tuples",
  "cases": [
    {
      "id": "tuple-basic",
      "category": "tuples",
      "description": "tupla a objeto anidado",
      "mode": "strict",
      "contract": {
        "prefix": "tp",
        "records_key": "rows",
        "core": [
          {
            "name": "id",
            "type": "str"
          },
          {
            "name": "pt",
            "type": "tuple",
            "items": [
              {
                "name": "x",
                "type": "int"
              },
              {
                "name": "y",
                "type": "float"
              },
              {
                "name": "tag",
                "type": "str",
                "optional": true
              }
            ]
          }
        ],
        "extensions": [
          {
            "name": "span",
            "type": "tuple",
            "items": [
              {
                "name": "lo",
                "type": "int"
              },
              {
                "name": "hi",
                "type": "int"
              }
            ]
          }
        ]
      },
      "input": "tp|n=1\nr1|3,-1.5,izq",
      "expected": {
        "canonical": {
          "prefix": "tp",
          "header": {
            "v": 1,
            "n": 1
          },
          "rows": [
            {
              "id": "r1",
              "pt": {
                "x": 3,
                "y": -1.5,
                "tag": "izq"
              },
              "span": null
            }
          ]
        },
        "mini": "tp|n=1\nr1|3,-1.5,izq"
      }
    },
