{
  "suite": ".mini conformance",
  "spec": "1.0",
  "category": "header",
  "cases": [
    {
      "id": "hdr-typed",
      "category": "header",
      "description": "claves de cabecera tipadas (lista, tupla, entero) y valor por defecto",
      "mode": "strict",
      "contract": {
        "prefix": "hd",
        "records_key": "rows",
        "header": {
          "required": [
            "n",
            "src"
          ],
          "keys": {
            "src": {
              "type": "str"
            },
            "ls": {
              "type": "list",
              "item": "int"
            },
            "tp": {
              "type": "tuple",
              "items": [
                {
                  "name": "a",
                  "type": "int"
                },
                {
                  "name": "b",
                  "type": "str"
                }
              ]
            },
            "k": {
              "type": "int"
            },
            "lang": {
              "type": "str",
              "default": "es"
            }
          }
        },
        "core": [
          {
            "name": "id",
            "type": "str"
          }
        ]
      },
      "input": "hd|n=1|src=clase 3|ls=1,2,3|tp=7,siete|k=2\nx",
      "expected": {
        "canonical": {
          "prefix": "hd",
          "header": {
            "v": 1,
            "n": 1,
            "src": "clase 3",
            "ls": [
              1,
              2,
              3
            ],
            "tp": {
              "a": 7,
              "b": "siete"
            },
            "k": 2,
            "lang": "es"
          },
          "rows": [
            {
              "id": "x"
            }
          ]
        }
      }
    },
