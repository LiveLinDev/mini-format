            "type": "float",
            "min": -1,
            "max": 1
          },
          {
            "name": "flag",
            "type": "bool"
          },
          {
            "name": "color",
            "type": "enum",
            "values": [
              "red",
              "green",
              "blue"
            ]
          }
        ],
        "extensions": [
          {
            "name": "memo",
            "type": "str"
          },
          {
            "name": "extra",
            "type": "int"
          }
        ]
      },
      "input": "sc|n=3\nr1|5|0.5|true|red\nr1|6|0.5|true|red\nr2|7|0.5|true|red",
      "expected": {
        "canonical": {
          "prefix": "sc",
          "header": {
            "v": 1,
            "n": 3
          },
          "rows": [
            {
              "id": "r1",
              "qty": 5,
              "ratio": 0.5,
              "flag": true,
              "color": "red",
              "memo": null,
              "extra": null
            },
            {
              "id": "r2",
              "qty": 7,
              "ratio": 0.5,
              "flag": true,
              "color": "red",
              "memo": null,
              "extra": null
            }
          ]
        },
        "errors": [
          {
            "code": "E11",
            "line": 3
          }
        ],
        "diagnostics": {
          "invalid_lines": [
            3
          ],
          "missing_records": 0
        }
      }
    },
