{
  "suite": ".mini conformance",
  "spec": "1.0",
  "category": "unique",
  "cases": [
    {
      "id": "unique-dup",
      "category": "unique",
      "description": "valor repetido en campo unique (E11)",
      "mode": "strict",
      "contract": {
        "prefix": "sc",
        "records_key": "rows",
        "core": [
          {
            "name": "id",
            "type": "str",
            "unique": true
          },
          {
            "name": "qty",
            "type": "int",
            "min": 0,
            "max": 100
          },
          {
            "name": "ratio",
            "type": "float",
            "min": -1,
            "max": 1
          },
          {
            "name": "flag",
            "type": "bool"
          },
          {
            "name": "color",
            "type": "enum",
            "values": [
              "red",
              "green",
              "blue"
            ]
          }
        ],
        "extensions": [
          {
            "name": "memo",
            "type": "str"
          },
          {
            "name": "extra",
            "type": "int"
          }
        ]
      },
      "input": "sc|n=2\nr1|5|0.5|true|red\nr1|6|0.5|true|red",
      "expected": {
        "errors": [
          {
            "code": "E11",
            "line": 3
          }
        ]
      }
    },
    {
      "id": "unique-dup-lenient",
      "category": "unique",
      "description": "modo tolerante conserva la primera aparición",
      "mode": "lenient",
      "contract": {
        "prefix": "sc",
        "records_key": "rows",
        "core": [
          {
            "name": "id",
            "type": "str",
            "unique": true
          },
          {
            "name": "qty",
            "type": "int",
            "min": 0,
            "max": 100
          },
          {
