{
  "suite": ".mini conformance",
  "spec": "1.1",
  "category": "contract",
  "cases": [
    {
      "id": "contract-minimal-valid",
      "category": "contract",
      "description": "contrato mínimo válido",
      "mode": "contract",
      "input": {
        "prefix": "ok",
        "core": [
          {
            "name": "id",
            "type": "str"
          }
        ]
      },
      "expected": {
        "errors": []
      }
    },
    {
      "id": "contract-no-prefix",
      "category": "contract",
      "description": "contrato inválido: falta prefix (E20)",
      "mode": "contract",
      "input": {
        "core": [
          {
            "name": "id",
            "type": "str"
          }
        ]
      },
      "expected": {
        "errors": [
          {
            "code": "E20",
            "line": 0
          }
        ]
      }
    },
    {
      "id": "contract-bad-prefix",
      "category": "contract",
      "description": "contrato inválido: prefix con caracteres inválidos (E20)",
      "mode": "contract",
      "input": {
        "prefix": "1x",
        "core": [
          {
            "name": "id",
            "type": "str"
          }
        ]
      },
      "expected": {
        "errors": [
          {
            "code": "E20",
            "line": 0
          }
        ]
      }
    },
    {
      "id": "contract-no-core",
      "category": "contract",
      "description": "contrato inválido: sin campos núcleo (E20)",
      "mode": "contract",
      "input": {
        "prefix": "x",
        "core": []
      },
      "expected": {
        "errors": [
          {
            "code": "E20",
            "line": 0
          }
        ]
      }
    },
    {
