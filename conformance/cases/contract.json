          }
        ]
      },
      "expected": {
        "errors": [
          {
            "code": "E20",
            "line": 0
          }
        ]
      }
    },
    {
      "id": "contract-bad-marker",
      "category": "contract",
      "description": "contrato inválido: regla de marcador desconocida (E20)",
      "mode": "contract",
      "input": {
        "prefix": "x",
        "core": [
          {
            "name": "m",
            "type": "mlist",
            "marker": "two"
          }
        ]
      },
      "expected": {
        "errors": [
          {
            "code": "E20",
            "line": 0
          }
        ]
      }
    },
    {
      "id": "contract-tuple-no-items",
      "category": "contract",
      "description": "contrato inválido: tupla sin componentes (E20)",
      "mode": "contract",
