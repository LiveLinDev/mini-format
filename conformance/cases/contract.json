      },
      "expected": {
        "errors": [
          {
            "code": "E20",
            "line": 0
          }
        ]
      }
    },
    {
      "id": "contract-tuple-nested",
      "category": "contract",
      "description": "contrato inválido: tupla con componente compuesto (E20)",
      "mode": "contract",
      "input": {
        "prefix": "x",
        "core": [
          {
            "name": "t",
            "type": "tuple",
            "items": [
              {
                "name": "l",
                "type": "list"
              }
            ]
          }
        ]
      },
      "expected": {
        "errors": [
          {
            "code": "E20",
            "line": 0
          }
        ]
      }
    },
    {
      "id": "contract-duplicate-field",
      "category": "contract",
      "description": "contrato inválido: nombres de campo duplicados (E20)",
      "mode": "contract",
      "input": {
        "prefix": "x",
        "core": [
          {
            "name": "id",
            "type": "str"
          }
        ],
        "extensions": [
          {
            "name": "id",
            "type": "int"
          }
        ]
      },
      "expected": {
        "errors": [
          {
            "code": "E20",
            "line": 0
          }
        ]
      }
    },
