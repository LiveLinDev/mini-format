{
  "suite": ".mini conformance",
  "spec": "1.1",
  "category": "lists",
  "cases": [
    {
      "id": "list-basic",
      "category": "lists",
      "description": "listas de str, int y enum",
      "mode": "strict",
      "contract": {
        "prefix": "ls",
        "records_key": "rows",
        "header": {
          "required": [
            "n"
          ],
          "keys": {
            "k": {
              "type": "int"
            }
          }
        },
        "core": [
          {
            "name": "id",
            "type": "str"
          },
          {
            "name": "xs",
            "type": "list",
            "item": "str",
            "min": 1,
            "max": 3
          },
          {
            "name": "ns",
            "type": "list",
            "item": "int"
          },
          {
            "name": "es",
            "type": "list",
            "item": "enum",
            "item_values": [
              "a",
              "b"
            ]
          },
          {
            "name": "ks",
            "type": "list",
            "item": "str",
            "count_key": "k"
          }
        ]
      },
      "input": "ls|n=1|k=2\nr1|x|1,2|a|p,q",
      "expected": {
        "canonical": {
          "prefix": "ls",
          "header": {
            "v": 1,
            "n": 1,
            "k": 2
          },
          "rows": [
            {
              "id": "r1",
              "xs": [
                "x"
              ],
              "ns": [
                1,
                2
              ],
              "es": [
                "a"
              ],
              "ks": [
                "p",
                "q"
              ]
            }
          ]
        },
        "mini": "ls|n=1|k=2\nr1|x|1,2|a|p,q"
      }
    },
