{
  "prefix": "card",
  "version": 1,
  "parent": null,
  "name": "Flashcards (spaced repetition)",
  "domain": "education / microlearning",
  "records_key": "cards",
  "description": "One flashcard per line: front, back, optional hint, tags, Bloom level and an initial ease factor for spaced repetition.",
  "header": {
    "required": [
      "n"
    ],
    "keys": {
      "d": {
        "type": "str",
        "desc": "generation date YYYYMMDD"
      },
      "l": {
        "type": "str",
        "desc": "language code"
      },
      "t": {
        "type": "str"
      },
      "src": {
        "type": "str",
        "desc": "source lesson id"
      }
    }
  },
  "core": [
    {
      "name": "id",
      "type": "str",
      "unique": true
    },
    {
      "name": "topic",
      "type": "str"
    },
    {
      "name": "front",
      "type": "str"
    },
    {
      "name": "back",
      "type": "str"
    },
    {
      "name": "hint",
      "type": "str",
      "optional": true
    },
    {
      "name": "tags",
      "type": "list",
      "item": "str",
      "min": 0,
      "max": 8
    },
    {
      "name": "bloom",
      "type": "enum",
      "values": [
        "L1",
        "L2",
        "L3",
        "L4",
        "L5",
        "L6"
      ]
    },
    {
      "name": "ease",
      "type": "float",
      "min": 1.3,
      "max": 3.0
    }
  ],
  "extensions": [],
  "author": "A. E. J. Palma Obispo, E. J. Palomino Santa Cruz (UPC)",
  "license": "MIT",
  "source": "mini-format reference forks"
}